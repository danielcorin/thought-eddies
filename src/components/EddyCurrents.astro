---
// A slow stream runs left to right across the footer. Two unseen stones
// part the flow and shed alternating eddies that drift downstream and
// dissolve; fine streaks of dye wind into each one and show which way it
// turns.
//
// The water is an analytic velocity field (uniform stream, potential flow
// around each stone, compact vortex blobs for the eddies). A first pass
// traces every pixel backwards through that field for a fixed span of
// seconds to find where its dye came from, at reduced resolution, packed
// into an ordinary RGBA8 texture. A second pass evaluates the dye pattern
// at those source coordinates at full resolution, so the streaks stay
// crisp wherever the tracing is smooth. Nothing accumulates between
// frames: the look is exact every frame, needs no float textures, and a
// single still frame is as settled as a running one.
---

<div class="eddy-current" data-eddy-current aria-hidden="true">
  <div class="eddy-current-fallback"></div>
  <canvas class="eddy-current-canvas"></canvas>
</div>

<style>
  .eddy-current {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .eddy-current-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at 20% 85%,
        color-mix(in srgb, var(--color-ink) 7%, transparent),
        transparent 55%
      ),
      radial-gradient(
        ellipse at 80% 110%,
        color-mix(in srgb, var(--color-ink) 5%, transparent),
        transparent 60%
      );
  }

  .eddy-current-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease-out;
  }

  .eddy-current.is-active .eddy-current-fallback {
    opacity: 0;
  }

  .eddy-current-canvas.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .eddy-current-canvas {
      transition: none;
    }
  }
</style>

<script>
  type Rgb = [number, number, number];
  // Positions are in footer heights, x to the right and y up from the
  // bottom edge. Every vortex moves in a straight line from where it was
  // born, so its position is a function of its age and needs no stepping.
  type Vortex = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    born: number;
    core: number; // radius of peak tangential speed
    peak: number; // signed peak tangential speed, positive anticlockwise
    ramp: number; // seconds to spin up
    decay: number; // e-folding time of the strength
    life: number; // seconds until removal; fades over the last few
  };
  type Stone = { x: number; y: number; r: number; next: number; side: number };
  const FLOW = 0.1; // stream speed, footer heights per second
  const MAX_VORTICES = 16;
  const MAX_STONES = 2;
  const TRACE_DT = 0.5; // seconds per trace step
  const SHED_PERIOD = 8; // seconds between eddies from one stone
  const WARP_RATIO = 0.6; // tracing resolution relative to CSS pixels
  const WARM_UP = 60; // seconds of shedding simulated before the first frame
  const FRAME_INTERVAL = 1000 / 30;
  const VERTEX = `
    attribute vec2 aPosition;
    varying vec2 vUv;
    void main() {
      vUv = aPosition * 0.5 + 0.5;
      gl_Position = vec4(aPosition, 0.0, 1.0);
    }
  `;

  // Shared by both passes: packing of traced coordinates into RGBA8.
  const RANGES = `
    #define X_MIN -8.0
    #define X_RANGE 24.0
    #define Y_MIN -4.0
    #define Y_RANGE 10.0
  `;

  // Pass 1: where did the dye under this pixel come from?
  const WARP = `
    varying vec2 vUv;
    uniform float uAspect;
    uniform float uTime;
    uniform float uFlow;
    uniform int uCount;
    uniform vec4 uVortices[${MAX_VORTICES}];
    uniform int uStoneCount;
    uniform vec4 uStones[${MAX_STONES}];

    // The eddies drift slowly enough that the field is treated as frozen
    // for the whole trace.
    vec2 velocity(vec2 p) {
      // A gentle meander keeps the open water from reading as ruled lines.
      vec2 v = vec2(uFlow, uFlow * 0.22 * sin(p.x * 1.1 + uTime * 0.05));
      // Potential flow around a cylinder: the stream parts and rejoins.
      for (int i = 0; i < ${MAX_STONES}; i++) {
        if (i >= uStoneCount) break;
        vec2 d = p - uStones[i].xy;
        float a2 = uStones[i].z * uStones[i].z;
        float r2 = max(dot(d, d), a2);
        v += uFlow * a2 / (r2 * r2) * vec2(d.y * d.y - d.x * d.x, -2.0 * d.x * d.y);
      }
      // Scully vortices with a compact far field, so each eddy is a
      // distinct blob and can leave the stage without a visible snap.
      for (int i = 0; i < ${MAX_VORTICES}; i++) {
        if (i >= uCount) break;
        vec2 d = p - uVortices[i].xy;
        float r2 = dot(d, d);
        float reach = 0.64 / (r2 + 0.64);
        v += uVortices[i].z * reach * reach * vec2(-d.y, d.x) / (r2 + uVortices[i].w);
      }
      return v;
    }

    // One midpoint step backwards in time.
    vec2 trace(vec2 s) {
      vec2 mid = s - 0.5 * DT * velocity(s);
      return s - DT * velocity(mid);
    }

    vec2 pack(float value) {
      float v = clamp(value, 0.0, 1.0) * 255.0;
      float hi = floor(v);
      return vec2(hi / 255.0, v - hi);
    }

    void main() {
      vec2 s = vUv * vec2(uAspect, 1.0);
      for (int k = 0; k < STEPS; k++) {
        s = trace(s);
      }
      gl_FragColor = vec4(pack((s.x - X_MIN) / X_RANGE), pack((s.y - Y_MIN) / Y_RANGE));
    }
  `;

  // Pass 2: draw the dye that belongs at each source coordinate.
  const DISPLAY = `
    varying vec2 vUv;
    uniform sampler2D uWarp;
    uniform vec2 uWarpSize;
    uniform float uAspect;
    uniform float uTime;
    uniform float uFlow;
    uniform float uDark;
    uniform float uPixel;
    uniform vec3 uInk;
    uniform int uStoneCount;
    uniform vec4 uStones[${MAX_STONES}];

    #define PI 3.14159265
    #define TAU 6.2831853

    float unpack(vec2 c) {
      return (c.x * 255.0 + c.y) / 255.0;
    }

    vec2 decode(vec4 c) {
      return vec2(unpack(c.xy) * X_RANGE + X_MIN, unpack(c.zw) * Y_RANGE + Y_MIN);
    }

    float jump = 0.0;

    // Bilinear interpolation of the packed trace by hand; the texture is
    // sampled nearest so the packed bytes arrive intact.
    vec2 source() {
      vec2 st = vUv * uWarpSize - 0.5;
      vec2 i = floor(st);
      vec2 f = st - i;
      vec2 texel = 1.0 / uWarpSize;
      vec2 b = (i + 0.5) * texel;
      vec2 s00 = decode(texture2D(uWarp, b));
      vec2 s10 = decode(texture2D(uWarp, b + vec2(texel.x, 0.0)));
      vec2 s01 = decode(texture2D(uWarp, b + vec2(0.0, texel.y)));
      vec2 s11 = decode(texture2D(uWarp, b + texel));
      // How far the four sources disagree: large where the mapping is
      // folded finer than a texel, or torn along a dividing streamline.
      jump = max(
        max(distance(s00, s10), distance(s01, s11)),
        max(distance(s00, s01), distance(s10, s11))
      );
      return mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
    }

    float hash(float n) {
      return fract(sin(n * 12.9898 + 78.233) * 43758.5453);
    }

    void main() {
      vec2 p = vUv * vec2(uAspect, 1.0);
      vec2 s = source();
      float spread = smoothstep(1.4, 4.8, uAspect);
      // Material x: the dye itself drifts downstream with the water, so
      // the streaks travel along the lines they are drawn on.
      float xs = s.x - uFlow * uTime;

      // Lines of dye laid across the stream, each with its own weight and
      // its own broken rhythm of streaks.
      float k = mix(46.0, 54.0, spread);
      float wobble = 0.022 * sin(xs * 1.9 + s.y * 2.0)
                   + 0.010 * sin(xs * 4.7 + 1.3);
      float phase = (s.y + wobble) * k;
      float n = floor(phase / PI + 0.5);
      float h1 = hash(n);
      float h2 = hash(n + 17.0);
      float weight = step(0.15, h1) * mix(0.45, 1.0, h2);
      float dp = xs * mix(1.1, 2.4, h1) + h2 * TAU;
      float dash = smoothstep(-0.55, 0.4, sin(dp) + 0.45 * sin(dp * 2.3 + 1.0));

      #ifdef HAS_DERIVATIVES
        float fw = max(fwidth(phase), 1e-4);
      #else
        float fw = k * uPixel;
      #endif
      float wave = abs(sin(phase));
      float hw = fw * 0.6;
      float line = 1.0 - smoothstep(hw, hw + fw, wave);
      // Where the dye is wound finer than a pixel, show its average as a
      // soft wash instead of letting it shimmer.
      float fine = smoothstep(0.45, 1.0, fw);
      // A dividing streamline behind a stone tears the mapping; the dye
      // there is a shadow line, not a stripe pattern.
      float torn = smoothstep(0.9, 2.0, jump * k);
      float coverage = min(fw * 0.7, 0.6);
      float ink = mix(line * weight * dash, coverage * 0.32, fine);
      ink = mix(ink, coverage * 0.1, torn);

      // The stones themselves are only ever implied: a quiet disc the dye
      // flows around.
      float mask = 1.0;
      for (int i = 0; i < ${MAX_STONES}; i++) {
        if (i >= uStoneCount) break;
        float r = uStones[i].z;
        mask *= smoothstep(r * 0.95, r * 1.18, length(p - uStones[i].xy));
      }

      float fade = 1.0 - smoothstep(0.42, 0.98, vUv.y);
      float amount = ink * mix(0.36, 0.4, uDark) * mask * fade;
      // Narrow screens put every link over the water; keep the centre
      // quieter while the eddies stay distinct along the edges.
      float quietCentre = exp(-pow(abs(vUv.x - 0.5) * 3.2, 4.0));
      amount *= 1.0 - 0.45 * quietCentre * (1.0 - spread);
      // Premultiplied transparency lets the page background show through,
      // including during its CSS theme transition.
      gl_FragColor = vec4(uInk * amount, amount);
    }
  `;

  function smoothstep(a: number, b: number, x: number) {
    const t = Math.min(Math.max((x - a) / (b - a), 0), 1);
    return t * t * (3 - 2 * t);
  }

  function start() {
    const host = document.querySelector<HTMLElement>('[data-eddy-current]');
    const canvas = host?.querySelector('canvas');
    if (!host || !canvas || host.dataset.initialized) return;
    host.dataset.initialized = 'true';

    const nav = navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
      deviceMemory?: number;
    };
    if (
      nav.connection?.saveData ||
      ['slow-2g', '2g'].includes(nav.connection?.effectiveType ?? '')
    ) {
      return;
    }

    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const hover = matchMedia('(hover: hover) and (pointer: fine)');
    const lowPower =
      !hover.matches ||
      (navigator.hardwareConcurrency || 8) <= 4 ||
      (nav.deviceMemory ?? 8) <= 4;
    // Half-second steps suit the slow eddies: their fastest cores turn
    // about 0.35 rad per step, where the midpoint rule is still accurate.
    // This traces 16 to 20 seconds back.
    const traceSteps = lowPower ? 32 : 40;
    let pixelRatioCap = lowPower ? 1 : 1.5;
    let gl: WebGLRenderingContext | null = null;
    let warpProgram: WebGLProgram | null = null;
    let displayProgram: WebGLProgram | null = null;
    let buffer: WebGLBuffer | null = null;
    let warpTexture: WebGLTexture | null = null;
    let framebuffer: WebGLFramebuffer | null = null;
    let warpUniforms: Record<string, WebGLUniformLocation | null> = {};
    let displayUniforms: Record<string, WebGLUniformLocation | null> = {};
    let warpWidth = 1;
    let warpHeight = 1;
    let inView = false;
    let failed = false;
    let lost = false;
    let disposed = false;
    let frameId = 0;
    let previousFrame = 0;
    let elapsed = 0;
    let aspect = 1;
    let rawDpr = 1;
    let slowFrames = 0;
    let sampledFrames = 0;
    let sampleTime = 0;
    let qualitySettled = false;
    let vortices: Vortex[] = [];
    let stones: Stone[] = [];
    const vortexUniforms = new Float32Array(MAX_VORTICES * 4);
    const stoneUniforms = new Float32Array(MAX_STONES * 4);
    let ink: Rgb = [0.18, 0.2, 0.21];
    let dark = false;
    const events = new AbortController();

    // A small seeded generator keeps the shedding rhythm identical across
    // reloads, so the reduced-motion frame is always the same picture.
    let seed = 2463534242;
    function random() {
      seed = (seed * 1664525 + 1013904223) % 4294967296;
      return seed / 4294967296;
    }

    // Resolve the site's theme colour variables through CSS.
    const colorProbe = document.createElement('span');
    colorProbe.style.display = 'none';
    host.append(colorProbe);
    function readColor(variable: string, fallback: Rgb): Rgb {
      colorProbe.style.color = `var(${variable})`;
      const value = getComputedStyle(colorProbe).color;
      const channels = value.match(/^rgba?\(([^)]+)\)/)?.[1].match(/[\d.]+/g);
      return channels && channels.length >= 3
        ? (channels.slice(0, 3).map((c) => Number(c) / 255) as Rgb)
        : fallback;
    }
    function readTheme() {
      ink = readColor('--color-ink', ink);
      dark = document.documentElement.classList.contains('dark');
    }

    // One stone on narrow stages, two once there is room for both wakes.
    function layoutStones() {
      const spread = smoothstep(1.4, 4.8, aspect);
      const r = 0.13 + 0.04 * spread;
      const wanted =
        aspect < 2.6
          ? [{ x: Math.max(0.3, aspect * 0.28), y: 0.3, r }]
          : [
              { x: aspect * 0.17, y: 0.3, r },
              { x: aspect * 0.56, y: 0.36, r: r * 0.9 },
            ];
      stones = wanted.map((stone, index) => ({
        ...stone,
        next: stones[index]?.next ?? elapsed + index * SHED_PERIOD * 0.5,
        side: stones[index]?.side ?? (index % 2 ? -1 : 1),
      }));
    }

    function shed(stone: Stone) {
      const spread = smoothstep(1.4, 4.8, aspect);
      vortices.push({
        x: stone.x + stone.r * 0.8,
        y: stone.y + stone.side * stone.r * 0.9,
        vx: FLOW * (0.8 + 0.1 * random()),
        vy: stone.side * 0.004,
        born: elapsed,
        core: 0.24 + 0.05 * spread,
        // Upper eddies turn clockwise, lower ones anticlockwise.
        peak: -stone.side * 0.075 * (0.9 + 0.2 * random()),
        ramp: 4,
        decay: 18,
        life: 40,
      });
      stone.side = -stone.side;
      stone.next = elapsed + SHED_PERIOD * (0.85 + 0.3 * random());
    }

    function advance(now: number) {
      elapsed = now;
      for (const stone of stones) {
        while (stone.next <= elapsed) shed(stone);
      }
      vortices = vortices.filter((v) => {
        const age = elapsed - v.born;
        return age < v.life && v.x + v.vx * age < aspect + 1.3;
      });
      if (vortices.length > MAX_VORTICES) {
        vortices.splice(0, vortices.length - MAX_VORTICES);
      }
    }

    function envelope(v: Vortex) {
      const age = elapsed - v.born;
      return (
        smoothstep(0, v.ramp, age) *
        Math.exp(-age / v.decay) *
        (1 - smoothstep(v.life - 6, v.life, age))
      );
    }

    function stop() {
      cancelAnimationFrame(frameId);
      frameId = 0;
      previousFrame = 0;
    }
    function releaseResources() {
      if (!gl) return;
      if (framebuffer) gl.deleteFramebuffer(framebuffer);
      if (warpTexture) gl.deleteTexture(warpTexture);
      if (buffer) gl.deleteBuffer(buffer);
      if (warpProgram) gl.deleteProgram(warpProgram);
      if (displayProgram) gl.deleteProgram(displayProgram);
      framebuffer = null;
      warpTexture = null;
      buffer = null;
      warpProgram = null;
      displayProgram = null;
    }
    function fallback() {
      failed = true;
      stop();
      canvas!.classList.remove('is-visible');
      host!.classList.remove('is-active');
      releaseResources();
    }

    function compile(type: number, source: string) {
      const shader = gl!.createShader(type);
      if (!shader) return null;
      gl!.shaderSource(shader, source);
      gl!.compileShader(shader);
      if (!gl!.getShaderParameter(shader, gl!.COMPILE_STATUS)) {
        console.warn(
          '[eddy] Shader compilation failed:',
          gl!.getShaderInfoLog(shader)
        );
        gl!.deleteShader(shader);
        return null;
      }
      return shader;
    }

    function link(fragmentSource: string, names: string[]) {
      const vertex = compile(gl!.VERTEX_SHADER, VERTEX);
      const fragment = compile(gl!.FRAGMENT_SHADER, fragmentSource);
      if (!vertex || !fragment) {
        if (vertex) gl!.deleteShader(vertex);
        if (fragment) gl!.deleteShader(fragment);
        return null;
      }
      const program = gl!.createProgram();
      if (!program) {
        gl!.deleteShader(vertex);
        gl!.deleteShader(fragment);
        return null;
      }
      gl!.attachShader(program, vertex);
      gl!.attachShader(program, fragment);
      gl!.bindAttribLocation(program, 0, 'aPosition');
      gl!.linkProgram(program);
      gl!.deleteShader(vertex);
      gl!.deleteShader(fragment);
      if (!gl!.getProgramParameter(program, gl!.LINK_STATUS)) {
        console.warn(
          '[eddy] Program link failed:',
          gl!.getProgramInfoLog(program)
        );
        gl!.deleteProgram(program);
        return null;
      }
      const uniforms: Record<string, WebGLUniformLocation | null> = {};
      for (const name of names) {
        uniforms[name] = gl!.getUniformLocation(program, name);
      }
      return { program, uniforms };
    }

    function setup() {
      gl = canvas!.getContext('webgl', {
        alpha: true,
        premultipliedAlpha: true,
        antialias: false,
        depth: false,
        stencil: false,
        powerPreference: 'low-power',
      });
      if (!gl) return false;
      // Tracing accumulates forty steps; it needs real 32-bit floats.
      const precision = gl.getShaderPrecisionFormat(
        gl.FRAGMENT_SHADER,
        gl.HIGH_FLOAT
      );
      if (!precision?.precision) return false;
      const derivatives = gl.getExtension('OES_standard_derivatives');
      const warp = link(
        `precision highp float;\n` +
          `#define STEPS ${traceSteps}\n#define DT ${TRACE_DT.toFixed(4)}\n` +
          RANGES +
          WARP,
        [
          'uAspect',
          'uTime',
          'uFlow',
          'uCount',
          'uVortices[0]',
          'uStoneCount',
          'uStones[0]',
        ]
      );
      const display = link(
        (derivatives
          ? '#extension GL_OES_standard_derivatives : enable\n#define HAS_DERIVATIVES\n'
          : '') +
          'precision highp float;\n' +
          RANGES +
          DISPLAY,
        [
          'uWarp',
          'uWarpSize',
          'uAspect',
          'uTime',
          'uFlow',
          'uDark',
          'uPixel',
          'uInk',
          'uStoneCount',
          'uStones[0]',
        ]
      );
      if (!warp || !display) {
        if (warp) gl.deleteProgram(warp.program);
        if (display) gl.deleteProgram(display.program);
        return false;
      }
      warpProgram = warp.program;
      warpUniforms = warp.uniforms;
      displayProgram = display.program;
      displayUniforms = display.uniforms;

      buffer = gl.createBuffer();
      warpTexture = gl.createTexture();
      framebuffer = gl.createFramebuffer();
      if (!buffer || !warpTexture || !framebuffer) return false;
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 3, -1, -1, 3]),
        gl.STATIC_DRAW
      );
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
      gl.bindTexture(gl.TEXTURE_2D, warpTexture);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.disable(gl.BLEND);
      readTheme();
      resize();
      gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer);
      gl.framebufferTexture2D(
        gl.FRAMEBUFFER,
        gl.COLOR_ATTACHMENT0,
        gl.TEXTURE_2D,
        warpTexture,
        0
      );
      const complete =
        gl.checkFramebufferStatus(gl.FRAMEBUFFER) === gl.FRAMEBUFFER_COMPLETE;
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      if (!complete) return false;
      if (elapsed === 0) {
        // Let the stones shed for a while so the first frame already has
        // a street of eddies rather than empty water.
        advance(WARM_UP);
      }
      return true;
    }

    function resize() {
      if (!gl || lost || failed) return;
      const rect = host!.getBoundingClientRect();
      aspect = rect.width / Math.max(rect.height, 1);
      rawDpr = window.devicePixelRatio || 1;
      const maxSize = gl.getParameter(gl.MAX_VIEWPORT_DIMS) as Int32Array;
      const dpr = Math.min(
        rawDpr,
        pixelRatioCap,
        maxSize[0] / Math.max(rect.width, 1),
        maxSize[1] / Math.max(rect.height, 1)
      );
      canvas!.width = Math.max(1, Math.round(rect.width * dpr));
      canvas!.height = Math.max(1, Math.round(rect.height * dpr));
      const warpDpr = Math.min(dpr, WARP_RATIO);
      warpWidth = Math.max(1, Math.round(rect.width * warpDpr));
      warpHeight = Math.max(1, Math.round(rect.height * warpDpr));
      gl.bindTexture(gl.TEXTURE_2D, warpTexture);
      gl.texImage2D(
        gl.TEXTURE_2D,
        0,
        gl.RGBA,
        warpWidth,
        warpHeight,
        0,
        gl.RGBA,
        gl.UNSIGNED_BYTE,
        null
      );
      layoutStones();
    }

    function draw() {
      if (
        !gl ||
        !warpProgram ||
        !displayProgram ||
        failed ||
        lost ||
        disposed
      ) {
        return;
      }
      let count = 0;
      for (const v of vortices) {
        const age = elapsed - v.born;
        vortexUniforms[count * 4] = v.x + v.vx * age;
        vortexUniforms[count * 4 + 1] = v.y + v.vy * age;
        vortexUniforms[count * 4 + 2] = 2 * v.core * v.peak * envelope(v);
        vortexUniforms[count * 4 + 3] = v.core * v.core;
        count++;
      }
      stones.forEach((stone, index) => {
        stoneUniforms[index * 4] = stone.x;
        stoneUniforms[index * 4 + 1] = stone.y;
        stoneUniforms[index * 4 + 2] = stone.r;
      });

      // Pass 1: trace, at reduced resolution, into the packed texture.
      gl.bindTexture(gl.TEXTURE_2D, null);
      gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer);
      gl.viewport(0, 0, warpWidth, warpHeight);
      gl.useProgram(warpProgram);
      gl.uniform1f(warpUniforms.uAspect, aspect);
      gl.uniform1f(warpUniforms.uTime, elapsed);
      gl.uniform1f(warpUniforms.uFlow, FLOW);
      gl.uniform1i(warpUniforms.uCount, count);
      gl.uniform4fv(warpUniforms['uVortices[0]'], vortexUniforms);
      gl.uniform1i(warpUniforms.uStoneCount, stones.length);
      gl.uniform4fv(warpUniforms['uStones[0]'], stoneUniforms);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      // Pass 2: the dye, at full resolution, over the page.
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, canvas!.width, canvas!.height);
      gl.useProgram(displayProgram);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, warpTexture);
      gl.uniform1i(displayUniforms.uWarp, 0);
      gl.uniform2f(displayUniforms.uWarpSize, warpWidth, warpHeight);
      gl.uniform1f(displayUniforms.uAspect, aspect);
      gl.uniform1f(displayUniforms.uTime, elapsed);
      gl.uniform1f(displayUniforms.uFlow, FLOW);
      gl.uniform1f(displayUniforms.uDark, dark ? 1 : 0);
      gl.uniform1f(displayUniforms.uPixel, 1 / canvas!.height);
      gl.uniform3fv(displayUniforms.uInk, ink);
      gl.uniform1i(displayUniforms.uStoneCount, stones.length);
      gl.uniform4fv(displayUniforms['uStones[0]'], stoneUniforms);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      if (!canvas!.classList.contains('is-visible')) {
        if (gl.getError() !== gl.NO_ERROR) {
          fallback();
          return;
        }
        host!.classList.add('is-active');
        canvas!.classList.add('is-visible');
      }
    }

    function frame(now: number) {
      frameId = requestAnimationFrame(frame);
      if (previousFrame && now - previousFrame < FRAME_INTERVAL - 2) return;
      const delta = previousFrame ? (now - previousFrame) / 1000 : 1 / 30;
      previousFrame = now;
      advance(elapsed + Math.min(delta, 0.06));
      // Two light passes normally hold 30 fps. Lower resolution on
      // sustained slow frames, then use the CSS fallback if the smallest
      // tier cannot keep up.
      if (!qualitySettled && delta > 0 && delta < 0.3) {
        sampledFrames++;
        sampleTime += delta;
        if (delta > 0.055) slowFrames++;
        if (sampleTime > 4 && sampledFrames > 30) {
          if (slowFrames / sampledFrames > 0.4) {
            if (pixelRatioCap <= 0.65) {
              fallback();
              return;
            }
            pixelRatioCap = pixelRatioCap > 1 ? 1 : 0.65;
            resize();
          } else {
            qualitySettled = true;
          }
          slowFrames = sampledFrames = sampleTime = 0;
        }
      }
      try {
        if ((window.devicePixelRatio || 1) !== rawDpr) resize();
        draw();
      } catch {
        fallback();
      }
    }

    function updateRunState() {
      if (!inView || document.hidden || failed || lost || disposed) {
        stop();
        return;
      }
      if (!displayProgram) {
        try {
          if (!setup()) {
            fallback();
            return;
          }
        } catch {
          fallback();
          return;
        }
      }
      if (motion.matches) {
        stop();
        draw();
      } else if (!frameId) {
        frameId = requestAnimationFrame(frame);
      }
    }

    const intersection = new IntersectionObserver(
      (entries) => {
        inView = entries.some((entry) => entry.isIntersecting);
        updateRunState();
      },
      { rootMargin: '80px 0px' }
    );
    intersection.observe(host);
    const resizing = new ResizeObserver(() => {
      if (!displayProgram || lost || failed) return;
      resize();
      if (inView) draw();
    });
    resizing.observe(host);
    const theme = new MutationObserver(() => {
      readTheme();
      if (inView) draw();
    });
    theme.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    const options = { signal: events.signal };
    document.addEventListener('visibilitychange', updateRunState, options);
    motion.addEventListener('change', updateRunState, options);
    canvas.addEventListener(
      'webglcontextlost',
      (event) => {
        event.preventDefault();
        lost = true;
        stop();
        canvas.classList.remove('is-visible');
        host.classList.remove('is-active');
      },
      options
    );
    canvas.addEventListener(
      'webglcontextrestored',
      () => {
        lost = false;
        warpProgram = null;
        displayProgram = null;
        buffer = null;
        warpTexture = null;
        framebuffer = null;
        updateRunState();
      },
      options
    );
    document.addEventListener(
      'astro:before-swap',
      () => {
        disposed = true;
        stop();
        events.abort();
        intersection.disconnect();
        resizing.disconnect();
        theme.disconnect();
        releaseResources();
        colorProbe.remove();
      },
      { ...options, once: true }
    );
  }

  start();
  document.addEventListener('astro:page-load', start);
</script>
