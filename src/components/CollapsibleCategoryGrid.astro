---
interface CategoryItem {
  name: string;
  count: number;
}

interface Props {
  items: CategoryItem[];
  baseUrl: string;
  title?: string;
  defaultCollapsed?: boolean;
}

const {
  items,
  baseUrl,
  title = 'Browse by category',
  defaultCollapsed = true,
} = Astro.props;
---

<details class="categories" open={!defaultCollapsed}>
  <summary class="category-header">
    <span>{title}</span>
    <svg
      class="toggle-icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m9 5 7 7-7 7"></path>
    </svg>
  </summary>
  <nav class="category-list" aria-label="TIL categories">
    {
      items.map((item) => (
        <a
          href={`${baseUrl}/${encodeURIComponent(item.name)}`}
          class="category-link"
          aria-label={`${item.name}, ${item.count} ${item.count === 1 ? 'entry' : 'entries'}`}
        >
          <span class="category-name">{item.name}</span>
          <span class="category-count" aria-hidden="true">
            {item.count}
          </span>
        </a>
      ))
    }
  </nav>
</details>

<style>
  .categories {
    position: relative;
    margin-bottom: var(--spacing-lg);
  }

  .categories::before,
  .categories::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 1px;
    background: var(--soft-horizontal-divider);
    pointer-events: none;
  }

  .categories::before {
    top: 0;
  }

  .categories::after {
    bottom: 0;
  }

  .category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    min-height: 3.5rem;
    padding: var(--spacing-md) 0;
    list-style: none;
    cursor: pointer;
    color: var(--color-ink);
    font-family: var(--font-primary);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .category-header::-webkit-details-marker {
    display: none;
  }

  .category-header:hover {
    color: var(--color-accent);
  }

  .category-header:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .toggle-icon {
    flex: none;
    color: var(--color-ink-light);
    transition: transform 160ms ease;
  }

  .categories[open] .toggle-icon {
    transform: rotate(90deg);
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.25rem 0 1.5rem;
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    max-width: 100%;
    min-height: 2.25rem;
    padding: 0.375rem 0.625rem;
    background: color-mix(in srgb, var(--color-bg-code) 55%, transparent);
    border-radius: 0.25rem;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .category-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .category-count {
    flex: none;
    color: var(--color-ink-light);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .category-link:hover,
  .category-link:focus-visible {
    background: var(--color-bg-code);
    color: var(--color-accent);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle-icon,
    .category-link {
      transition: none;
    }
  }
</style>
