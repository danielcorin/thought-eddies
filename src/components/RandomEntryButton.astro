---
import { Icon } from 'astro-icon/components';

interface Props {
  collection: 'posts' | 'til' | 'logs';
  // "icon" sits next to a page title, "button" matches the raw/edit/commit row
  variant?: 'icon' | 'button';
  class?: string;
}

const { collection, variant = 'icon', class: className } = Astro.props;

const labels: Record<Props['collection'], string> = {
  posts: 'Random post',
  til: 'Random TIL',
  logs: 'Random log',
};
const label = labels[collection];
---

<button
  type="button"
  class:list={['random-entry', `random-entry--${variant}`, className]}
  data-random-collection={collection}
  aria-label={label}
  title={label}
>
  <Icon name="ph:dice-three" />
  {variant === 'button' && <span>random</span>}
</button>

<style>
  .random-entry {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    color: var(--color-ink-light);
  }

  .random-entry[disabled] {
    cursor: progress;
  }

  .random-entry--icon {
    padding: 0;
    opacity: 0.5;
    transition: all 0.2s ease;
  }

  .random-entry--icon:hover {
    color: var(--color-accent);
    opacity: 1;
    transform: rotate(-15deg) scale(1.1);
  }

  .random-entry--icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .random-entry--button {
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--color-bg-code);
    color: var(--color-ink);
    border-radius: 0.25rem;
    font-size: var(--text-sm);
    transition:
      background 0.2s,
      color 0.2s;
  }

  .random-entry--button:hover {
    background: var(--color-bg-hover);
    color: var(--color-ink);
  }

  .random-entry--button svg {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 640px) {
    .random-entry--icon svg {
      width: 1rem;
      height: 1rem;
    }
  }
</style>

<script>
  const lists = new Map<string, Promise<string[]>>();

  function loadUrls(collection: string): Promise<string[]> {
    if (!lists.has(collection)) {
      lists.set(
        collection,
        fetch(`/random/${collection}.json`)
          .then((res) => (res.ok ? res.json() : []))
          .catch(() => [])
      );
    }
    return lists.get(collection)!;
  }

  const normalize = (path: string) => path.replace(/\/+$/, '');

  document
    .querySelectorAll<HTMLButtonElement>('[data-random-collection]')
    .forEach((button) => {
      const collection = button.dataset.randomCollection!;

      // Warm the list before the click so navigation feels instant
      const prefetch = () => loadUrls(collection);
      button.addEventListener('pointerenter', prefetch, { once: true });
      button.addEventListener('focus', prefetch, { once: true });

      button.addEventListener('click', async () => {
        button.disabled = true;
        const urls = await loadUrls(collection);
        const here = normalize(window.location.pathname);
        // Never land on the page we're already reading
        const elsewhere = urls.filter((url) => normalize(url) !== here);
        const pool = elsewhere.length > 0 ? elsewhere : urls;

        if (pool.length === 0) {
          button.disabled = false;
          return;
        }

        window.location.href = pool[Math.floor(Math.random() * pool.length)];
      });
    });
</script>
