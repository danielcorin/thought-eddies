---
import { SEO } from "astro-seo";
import "@styles/theme.css";
import "@styles/base.css";
import Footer from "@components/layout/Footer.astro";
import ReadingProgress from "@components/layout/ReadingProgress.astro";
import ScrollToTop from "@components/layout/ScrollToTop.astro";
import KeyboardShortcutsModal from "@components/KeyboardShortcutsModal.astro";
import SearchModal from "@components/SearchModal";
interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	pageType?: string;
	// Keep thin listing pages (tags, pagination) out of search results.
	noindex?: boolean;
	// Markdown copy of this page, advertised to agents as an alternate.
	markdownUrl?: string;
	// Set on single entries to emit article metadata and JSON-LD.
	article?: {
		publishedTime?: Date;
		modifiedTime?: Date;
		tags?: string[];
	};
}

const SITE_NAME = "Thought Eddies";
const AUTHOR = { name: "Dan Corin", url: new URL("/about/", Astro.site).href };

const { title = "", ogImage, pageType, markdownUrl, article, noindex = false } = Astro.props;
const description =
	Astro.props.description?.replace(/\s+/g, " ").trim() || "An Experimental Digital Garden";
const pageTitle = title.trim() ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage || "/og.png", Astro.site).href;

const jsonLd = article && {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	url: canonicalUrl,
	mainEntityOfPage: canonicalUrl,
	image: ogImageUrl,
	datePublished: article.publishedTime?.toISOString(),
	dateModified: (article.modifiedTime ?? article.publishedTime)?.toISOString(),
	keywords: article.tags?.length ? article.tags.join(", ") : undefined,
	author: { "@type": "Person", ...AUTHOR },
	publisher: { "@type": "Person", ...AUTHOR },
};
---

<!doctype html>
<html lang="en" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Theme flicker prevention - runs immediately before page renders
			(function () {
				const savedTheme = localStorage.getItem("theme");
				const systemDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				const theme = savedTheme || (systemDark ? "dark" : "light");

				// Remove any existing theme classes and set the correct one
				document.documentElement.className = theme;
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;500;600&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="RSS Feed"
			href="/rss.xml"
		/>
		<link rel="webmention" href="https://webmention.io/www.danielcorin.com/webmention" />
		{pageType === "posts" || pageType === "postsList" ? (
			<link
				rel="alternate"
				type="application/rss+xml"
				title="Posts RSS Feed"
				href="/posts/rss.xml"
			/>
		) : pageType === "logs" || pageType === "logsYear" || pageType === "logsMonth" ? (
			<link
				rel="alternate"
				type="application/rss+xml"
				title="Logs RSS Feed"
				href="/logs/rss.xml"
			/>
		) : pageType === "til" || pageType === "tilList" ? (
			<link
				rel="alternate"
				type="application/rss+xml"
				title="TIL RSS Feed"
				href="/til/rss.xml"
			/>
		) : pageType === "garden" ? (
			<link
				rel="alternate"
				type="application/rss+xml"
				title="Garden RSS Feed"
				href="/garden/rss.xml"
			/>
		) : pageType === "projects" ? (
			<link
				rel="alternate"
				type="application/rss+xml"
				title="Projects RSS Feed"
				href="/projects/rss.xml"
			/>
		) : null}
		<meta name="generator" content={Astro.generator} />
		<SEO
			title={pageTitle}
			description={description}
			noindex={noindex}
			openGraph={{
				basic: {
					title: title.trim() || SITE_NAME,
					type: article ? "article" : "website",
					image: ogImageUrl,
					url: canonicalUrl,
				},
				optional: {
					description,
					siteName: SITE_NAME,
				},
				article: article && {
					publishedTime: article.publishedTime?.toISOString(),
					modifiedTime: article.modifiedTime?.toISOString(),
					authors: [AUTHOR.name],
					tags: article.tags,
				},
			}}
			twitter={{ card: "summary_large_image" }}
		/>
		{markdownUrl && (
			<link rel="alternate" type="text/markdown" href={markdownUrl} />
		)}
		{jsonLd && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		)}
	</head>
	<body class="posts">
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<ReadingProgress />

		<script is:inline>
			// Global theme toggle functionality - accessible to all components
			window.themeUtils = {
				enableLightTheme: function () {
					document.documentElement.className = "light";
					localStorage.setItem("theme", "light");
					window.dispatchEvent(
						new CustomEvent("themeChanged", {
							detail: { isDark: false },
						}),
					);
				},

				enableDarkTheme: function () {
					document.documentElement.className = "dark";
					localStorage.setItem("theme", "dark");
					window.dispatchEvent(
						new CustomEvent("themeChanged", {
							detail: { isDark: true },
						}),
					);
				},

				toggleTheme: function () {
					const currentTheme = document.documentElement.className;
					if (currentTheme === "dark") {
						window.themeUtils.enableLightTheme();
					} else {
						window.themeUtils.enableDarkTheme();
					}
				},

				getCurrentTheme: function () {
					return document.documentElement.className;
				},
			};

			// Global keyboard shortcuts
			document.addEventListener('keydown', function(e) {
				// Command+Shift+M or Ctrl+Shift+M for theme toggle
				if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.key.toLowerCase() === 'm') {
					e.preventDefault();
					window.themeUtils.toggleTheme();
				}
			});
		</script>

		<main id="main-content">
			<div class="content-wrapper">
				<slot />
			</div>
		</main>
		<div class="footer-area">
			<slot name="footer-background" />
			<Footer />
		</div>
		<ScrollToTop />
		<KeyboardShortcutsModal pageType={pageType} />
		<SearchModal client:only="react" />
		{pageType === "404" && (
			<script is:inline>
				// The prerendered 404 canonical URL hides the missing path.
				window.goatcounter = { path: window.location.pathname };
			</script>
		)}
		<script is:inline data-goatcounter="https://danielcorin.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
	</body>
</html>

<style>
	/* Full-width stage for the footer so a page can slot a decorative
	   background (e.g. the homepage's eddy shader) behind it. The footer
	   itself keeps the same centered column it had inside <main>. */
	.footer-area {
		position: relative;
		overflow: hidden;
	}

	.footer-area :global(footer) {
		position: relative;
		z-index: 1;
		max-width: 75ch;
		margin-left: auto;
		margin-right: auto;
	}
</style>
