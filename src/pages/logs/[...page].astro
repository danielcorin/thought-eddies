---
import Navigation from "@components/layout/Navigation.astro";
import Pagination from "@components/Pagination.astro";
import Tag from "@components/Tag.astro";
import YearNavigation from "@components/layout/YearNavigation.astro";
import Layout from "@layouts/Layout.astro";
import { getContentPreview } from "@utils/text";
import { getLogDateComponents, SHORT_MONTH_NAMES } from "@utils/markdownEndpoints";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import RandomEntryButton from "@components/RandomEntryButton.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const logs = await getCollection("logs");
  const sortedLogs = logs
    .filter((log) => !log.data.draft)
    .sort((a, b) => {
      return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    });

  // Use Astro's paginate function
  return paginate(sortedLogs, { pageSize: 10 });
};

const { page } = Astro.props as { page: any };


// Get all years with logs for navigation
const allLogs = await getCollection("logs");
const publishedLogs = allLogs.filter((log) => !log.data.draft);
const yearsWithLogs = [
  ...new Set(publishedLogs.map((log) => getLogDateComponents(log.id, new Date(log.data.date)).year)),
].sort((a, b) => b - a);

const ogImage = `/logs/og.png`;
---

<Layout title="Logs" ogImage={ogImage}>
  <Navigation selected="logs" />
  <main>
    <div class="header-container">
      <h1 class="page-title">
        Logs
        <RandomEntryButton collection="logs" />
      </h1>
    </div>

    <div class="toc">
      {
        page.data.map(async (log: any) => {
          const { year: logYear, month: logMonth, day: logDay } = getLogDateComponents(log.id, new Date(log.data.date));
          const rawContent = log.body || "";
          const preview = getContentPreview(rawContent, 200);

          return (
            <article class="entry soft-list-entry">
              <div class="entry-content">
                <time class="entry-date">
                  <a href={`/logs/${log.id}`} class="date-day">
                    {String(logDay).padStart(2, "0")}
                  </a>
                  <a
                    href={`/logs/${logYear}/${String(logMonth).padStart(2, "0")}`}
                    class="date-month"
                  >
                    {SHORT_MONTH_NAMES[logMonth - 1]}
                  </a>
                  <a href={`/logs/${logYear}`} class="date-year">
                    {logYear}
                  </a>
                </time>
                <p>{preview}</p>
                <div class="tags">
                  {log.data.tags && log.data.tags.length > 0 &&
                    log.data.tags.map((tag: string) => (
                      <Tag tag={tag} />
                    ))
                  }
                </div>
              </div>
              <a href={`/logs/${log.id}`} class="read-more" aria-label="Read full log">
                <Icon name="ph:arrow-right" class="arrow-icon" />
              </a>
            </article>
          );
        })
      }
    </div>

    {
      page.lastPage > 1 && (
        <div class="pagination-bottom">
          <Pagination
            currentPage={page.currentPage}
            lastPage={page.lastPage}
            prevUrl={page.url.prev}
            nextUrl={page.url.next}
            baseUrl="/logs"
          />
        </div>
      )
    }

    <YearNavigation years={yearsWithLogs} baseUrl="/logs" />
  </main>
</Layout>

<style>
  /* Reuse base.css styles as much as possible */

  .header-container {
    margin-bottom: var(--spacing-lg);
  }

  .subtitle {
    text-align: center;
    color: var(--color-ink-light);
    font-style: italic;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  /* Override toc article grid to be simpler for logs */
  .toc article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) clamp(0rem, 1vw, var(--spacing-sm));
    margin-bottom: 0;
  }

  .entry-content {
    min-width: 0;
  }

  .toc time {
    font-family: var(--font-mono);
  }

  .entry-date {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    line-height: 1;
    margin-bottom: var(--spacing-sm);
  }

  .entry-date a {
    color: var(--color-ink-light);
    text-decoration: none;
  }

  .entry-date a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .date-day {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .date-day:hover {
    color: var(--color-accent);
  }

  .date-month {
    font-size: var(--text-sm);
  }

  .date-year {
    font-size: var(--text-sm);
  }

  .toc p {
    margin: 0 0 var(--spacing-sm);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .tags {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-top: var(--spacing-sm);
  }

  .tags:empty {
    display: none;
  }

  .read-more {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-light);
    text-decoration: none;
    opacity: 0.5;
    transition: all 0.2s ease;
    align-self: center;
  }

  .read-more:hover {
    color: var(--color-accent);
    opacity: 1;
    transform: translateX(3px);
  }

  .arrow-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .pagination-bottom {
    margin-top: var(--spacing-xl);
  }


  @media (max-width: 640px) {
    .toc article {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--spacing-sm);
      padding: var(--spacing-lg) 0;
    }

    .entry-date {
      gap: 0.35rem;
    }

    .entry-content p {
      font-size: var(--text-sm);
    }
  }
</style>
